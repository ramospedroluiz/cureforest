Package: cureforest
Type: Package
Title: Cure-Fraction Trees and Random Survival Forests
Version: 0.1.1
Authors@R: c(
    person("Pedro Luiz", "Ramos", role = c("aut", "cre"),
           email = "pedro.ramos@uc.cl",
           comment = c(ORCID = "0000-0002-5387-2457")),
